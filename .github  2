name: Build APK

on:
  push:
    branches: [ main ]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Build APK
        run: |
          set +e
          gradle assembleRelease --no-daemon 2>&1 | tee build_log.txt
          if [ ${PIPESTATUS[0]} -ne 0 ]; then
            echo ""
            echo "==================== Kotlin 编译错误 ===================="
            grep -E "^e: " build_log.txt | head -60
            echo "========================================================"
            exit 1
          fi

      - name: Rename APK
        run: |
          cp app/build/outputs/apk/release/app-release.apk \
             app/build/outputs/apk/release/FocusMoment-v1.1.${{ github.run_number }}.apk

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: FocusMoment-APK
          path: app/build/outputs/apk/release/FocusMoment-v1.1.${{ github.run_number }}.apk

      - name: Create Release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: v1.1.${{ github.run_number }}
          name: 专注时刻 v1.1.${{ github.run_number }}
          files: app/build/outputs/apk/release/FocusMoment-v1.1.${{ github.run_number }}.apk
          body: |
            ## v1.1 更新内容
            - 手机号注册 / 登录，一键云同步
            - 白噪音扩充至 13 种，选择时自动试听
            - 壁纸大幅扩充，主题色更多可选
            - 铃声支持从手机音乐库选择
            - Release APK 体积更小，下载更快
            - 全新「待办集」：连续执行 / 单项休息 / 长休息 / 饼图统计
            - 底部导航：待办 · 待办集 · 日程 · 锁机 · 报告 · 我的
            - 锁机页：小憩 / 立刻快速锁机 / 自定义锁机时段
            - 报告可生成图片分享到微信等应用
            - 日程改为日历视图，支持单次 / 周 / 月 / 年 / 工作日 / 自定义重复，到点自动严格锁机
            - 字体大小、字体样式（楷体 / 行书 / 宋体 / 自定义导入）、语言设置
            - 启动图标页、版本更新检查、更新内容弹窗
            - 登录后可修改昵称和头像
